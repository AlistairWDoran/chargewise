# Deploy target for scripts/deploy-nas.py.
# Copy to local/deploy.env (git-ignored) and replace every value.
# Plain KEY=VALUE lines; lines starting with # are ignored.
# Environment variables of the same names take precedence over this file.

# Host name or address of the NAS (192.0.2.10 is a documentation address).
NAS_HOST=192.0.2.10
# SSH port on the NAS.
NAS_SSH_PORT=22
# SSH user that owns the destination directory.
NAS_USER=your-nas-user
# Private key for that user. A leading ~ is expanded; backslashes are kept as typed.
NAS_SSH_KEY=~/.ssh/your_key
# Destination directory on the NAS (holds backend/, docker-compose.nas.yml, .env, data/).
NAS_DEST=/path/on/nas/chargewise
