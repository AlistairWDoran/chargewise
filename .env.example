# ChargeWise configuration — copy to .env and fill in. NEVER commit your real .env.
# Read by backend/chargewise/config.py (pydantic-settings; unknown keys ignored).
# In the NAS deployment, docker-compose.nas.yml loads this via `env_file: .env`.

# Auth toggle: true for local dev / LAN-only deployments (no login required).
AUTH_DISABLED=true

# --- TeslaFi (history API) --- REQUIRED for TeslaFi ingestion
TESLAFI_TOKEN=your-teslafi-api-token

# --- Octopus Energy --- REQUIRED for Octopus ingestion
OCTOPUS_API_KEY=sk_live_xxx
OCTOPUS_ACCOUNT_NUMBER=A-XXXXXXXX

# --- Vehicle names (optional) ---
# Display names for the cars TeslaFi reports, keyed by VIN: "VIN=Name" entries
# separated by semicolons, with one pair of quotes around the whole value (or
# none). VINs may be typed in either case.
# A name may contain spaces, commas and apostrophes. It cannot contain ";",
# "=" or a double quote, and cannot start or end with an apostrophe.
# Used by the ingestion pipeline (and so by the daily scheduler) when no
# --vehicle-map flag is given; flags, when given, replace it.
# A vehicle is identified by its VIN; the name is only a label. A car already
# in the database keeps its stored name unless this map names its VIN, in
# which case it is renamed. A car seen for the first time with no name here is
# called "<Model> (<last 6 of VIN>)". For a car stored with its VIN, leaving
# it out of the map, or leaving the map empty, adds no second vehicle and
# stores no charge twice.
# A malformed value stops every mode of the pipeline before anything is
# fetched, with the number of the entry at fault and the reason. When the run
# was a TeslaFi one (the daily job is), /api/status shows the refusal as that
# source's last_error.
# The values below are placeholders: put your own VINs and names in .env.
VEHICLE_MAP="TESTVIN0000000001=First car;TESTVIN0000000002=Second car"

# --- Cost settings ---
AWAY_RATE_GBP_PER_KWH=0.50      # fallback when a public charge has no recorded cost
PETROL_MPG=30                   # petrol comparator: mpg of the petrol car you compare against
FUEL_TYPE=petrol                # petrol | diesel
EXCLUDE_STANDING_CHARGE=true    # standing charge is a fixed home cost, not a charging cost

# --- Storage ---
DATABASE_URL=sqlite:///./data/chargewise.sqlite

# --- Future (parked): OAuth login + Azure deployment ---
# The internet-facing dashboard (OAuth via Microsoft/Google) and the Azure/Key
# Vault deployment are deliberately parked — the LAN-first v1 shipped instead.
# These keys are read by config.py but unused while AUTH_DISABLED=true.
OAUTH_PROVIDER=microsoft        # microsoft | google
OAUTH_CLIENT_ID=
SESSION_SECRET=change-me
KEY_VAULT_NAME=                 # Azure Key Vault name; leave blank
